generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum RefundStatus {
  NONE
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
}

enum AdminRole {
  OWNER
  ADMIN
}

enum VenueInterestStatus {
  NEW
  REVIEWED
  CONTACTED
  ARCHIVED
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
  @@index([isActive])
}

model Venue {
  id        String   @id @default(cuid())

  name      String

  addressLine1 String?
  addressLine2 String?
  city         String?
  county       String?
  postcode     String?
  country      String?  @default("UK")

  latitude     Float?
  longitude    Float?

  isActive Boolean @default(true)

  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([postcode])
  @@index([isActive])
}

model Session {
  id        String @id @default(cuid())

  venueId   String
  venue     Venue  @relation(fields: [venueId], references: [id])

  title       String
  description String?

  startsAt DateTime
  endsAt   DateTime

  capacity   Int @default(10)
  pricePence Int @default(1000)

  minAge Int?
  maxAge Int?

  isActive Boolean @default(true)

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
  @@index([startsAt])
  @@index([isActive])
}

model Booking {
  id                  String @id @default(cuid())
  bookingReference    String @unique
  bookingAccessToken  String? @unique

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id])

  parentName  String
  parentEmail String
  parentPhone String?

  emergencyContactName  String?
  emergencyContactPhone String?

  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  refundStatus  RefundStatus  @default(NONE)

  totalAmountPence Int
  childCount        Int

  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  stripeRefundId          String?

  cancelledAt      DateTime?
  cancellationReason String?
  refundedAt       DateTime?

  consentAccepted   Boolean  @default(false)
  consentAcceptedAt DateTime?
  consentTextVersion String?

  marketingOptIn Boolean @default(false)

  children Child[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
  @@index([parentEmail])
  @@index([status])
  @@index([paymentStatus])
}

model Child {
  id String @id @default(cuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  firstName String
  lastName  String?

  dateOfBirth DateTime

  allergies    String?
  medicalNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([dateOfBirth])
}

model VenueInterest {
  id String @id @default(cuid())
  
  parentEmail String
  city        String
  venueName   String
  notes       String?

  status VenueInterestStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([status])
  @@index([createdAt])
}