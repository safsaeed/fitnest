generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum RefundStatus {
  NONE
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
}

enum AdminRole {
  OWNER
  ADMIN
}

enum VenueInterestStatus {
  NEW
  REVIEWED
  CONTACTED
  ARCHIVED
}

enum MembershipStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELLED
  UNPAID
}

enum BookingPricingType {
  STANDARD
  MEMBER
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([isActive])
}

model ParentUser {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  phone        String?
  passwordHash String

  defaultEmergencyContactName  String?
  defaultEmergencyContactPhone String?

  stripeCustomerId String? @unique

  isActive Boolean @default(true)

  children             ParentChild[]
  bookings             Booking[]
  membership           Membership?
  passwordResetTokens  ParentPasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([isActive])
}

model ParentPasswordResetToken {
  id           String     @id @default(cuid())
  parentUserId String
  parentUser   ParentUser @relation(fields: [parentUserId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([parentUserId])
  @@index([expiresAt])
  @@index([usedAt])
}

model ParentChild {
  id           String     @id @default(cuid())
  parentUserId String
  parentUser   ParentUser @relation(fields: [parentUserId], references: [id], onDelete: Cascade)

  firstName   String
  lastName    String?
  dateOfBirth DateTime

  allergies    String?
  medicalNotes String?

  isActive Boolean @default(true)

  bookingChildren Child[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentUserId])
  @@index([isActive])
  @@index([dateOfBirth])
}

model Membership {
  id           String     @id @default(cuid())
  parentUserId String     @unique
  parentUser   ParentUser @relation(fields: [parentUserId], references: [id], onDelete: Cascade)

  status MembershipStatus @default(INCOMPLETE)

  stripeSubscriptionId String? @unique
  stripePriceId        String?

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  cancelAtPeriodEnd Boolean   @default(false)
  cancelledAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([currentPeriodEnd])
}

model Venue {
  id String @id @default(cuid())

  name String

  addressLine1 String?
  addressLine2 String?
  city         String?
  county       String?
  postcode     String?
  country      String? @default("UK")

  latitude  Float?
  longitude Float?

  isActive Boolean @default(true)

  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([postcode])
  @@index([isActive])
}

model Session {
  id String @id @default(cuid())

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  title       String
  description String?

  startsAt DateTime
  endsAt   DateTime

  capacity         Int  @default(10)
  pricePence       Int  @default(1000)
  memberPricePence Int?

  minAge Int?
  maxAge Int?

  isActive Boolean @default(true)

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
  @@index([startsAt])
  @@index([isActive])
}

model Booking {
  id                 String @id @default(cuid())
  bookingReference   String @unique
  bookingAccessToken String @unique

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id])

  parentUserId String?
  parentUser   ParentUser? @relation(fields: [parentUserId], references: [id], onDelete: SetNull)

  parentName  String
  parentEmail String
  parentPhone String?

  emergencyContactName  String?
  emergencyContactPhone String?

  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  refundStatus  RefundStatus  @default(NONE)

  pricingType      BookingPricingType @default(STANDARD)
  unitPricePence   Int
  totalAmountPence Int
  childCount       Int

  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  stripeRefundId          String?

  cancelledAt        DateTime?
  cancellationReason String?
  refundedAt         DateTime?

  consentAccepted    Boolean   @default(false)
  consentAcceptedAt  DateTime?
  consentTextVersion String?

  marketingOptIn Boolean @default(false)

  children Child[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
  @@index([parentUserId])
  @@index([parentEmail])
  @@index([status])
  @@index([paymentStatus])
  @@index([pricingType])
}

model Child {
  id String @id @default(cuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  parentChildId String?
  parentChild   ParentChild? @relation(fields: [parentChildId], references: [id], onDelete: SetNull)

  firstName String
  lastName  String?

  dateOfBirth DateTime

  allergies    String?
  medicalNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([parentChildId])
  @@index([dateOfBirth])
}

model VenueInterest {
  id String @id @default(cuid())

  parentEmail String
  city        String
  venueName   String
  notes       String?

  status VenueInterestStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([status])
  @@index([createdAt])
}
